{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "DISABLE_TELEMETRY": "1",
    "ENABLE_TOOL_SEARCH": "auto:5",
    "CLAUDE_CODE_SCROLL_SPEED": "3",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-haiku-4.5",
    "ANTHROPIC_API+KEY": "dummy",
    "ANTHROPIC_MODEL": "claude-sonnet-4.6",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-4.7",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-4.6",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-4.5",
    "ANTHROPIC_BASE_URL": "http://localhost:4141"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Agent",
      "Bash",
      "Edit",
      "Glob",
      "Grep",
      "Read",
      "Write",
      "Skill",
      "TeamCreate",
      "WebSearch",
      "WebFetch",
      "mcp__*"
    ],
    "defaultMode": "acceptEdits"
  },
  "model": "claude-sonnet-4.6",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/lint-on-write.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/rtk-rewrite.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/cwd-trace.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/log-session-cost.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "context7@claude-plugins-official": true,
    "github@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "worktrunk@worktrunk": true,
    "claude-obsidian@claude-obsidian": true,
    "claude-workflow@claude-workflow": true
  },
  "extraKnownMarketplaces": {
    "worktrunk": {
      "source": {
        "source": "github",
        "repo": "max-sixty/worktrunk"
      }
    },
    "claude-obsidian": {
      "source": {
        "source": "github",
        "repo": "misiekhardcore/claude-obsidian"
      }
    },
    "claude-workflow": {
      "source": {
        "source": "github",
        "repo": "misiekhardcore/claude-workflow"
      }
    }
  },
  "tui": "fullscreen",
  "theme": "dark",
  "teammateMode": "tmux",
  "remoteControlAtStartup": true,
  "voiceEnabled": true
}
